# Fail installs when a peer dependency is missing or mismatched.
strict-peer-dependencies=true

# Don't auto-install peers; consumers must declare them explicitly.
auto-install-peers=false

# Hoist only what's strictly safe to the workspace root. Keeps each
# package's node_modules honest about what it actually depends on.
shamefully-hoist=false

# Use the modern isolated node_modules layout (default in pnpm 8+,
# pinned here so behavior doesn't drift if a contributor changes it).
node-linker=isolated

# Save exact-ish ranges (^1.2.3) — standard for libraries.
save-prefix=^

# Faster, more reliable lockfile resolution.
resolution-mode=highest
